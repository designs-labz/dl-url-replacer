<?xml version="1.0"?>
<ruleset name="DesignsLabz Relocate">
	<description>Coding standards for DesignsLabz Relocate.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra">
		<!-- Class files follow PSR-4 naming for the autoloader. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Working with the database directly is this plugin's purpose; every query is prepared and reviewed. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
		<!-- This sniff only recognises prepare() on a variable literally named $wpdb, so it flags every
		     $this->wpdb->prepare() call. InterpolatedNotPrepared still catches variables in SQL strings. -->
		<exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>
		<!-- Exception messages are data, not output: they are escaped where they are shown
		     (esc_html in templates, JSON in REST responses, plain text in WP-CLI). -->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="designslabz-relocate"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dlz_relocate"/>
				<element value="DesignsLabz\Relocate"/>
			</property>
		</properties>
		<!-- Templates are included from inside methods, so their variables are not globals. -->
		<exclude-pattern>/templates/*</exclude-pattern>
	</rule>

	<!-- Tests build serialized, JSON and random fixtures on purpose. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_unserialize">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Test fixtures build their own tables and set up the WordPress test environment. -->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
