<?xml version="1.0"?>
<phpunit
	bootstrap="vendor/autoload.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	convertDeprecationsToExceptions="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory>tests/Unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
